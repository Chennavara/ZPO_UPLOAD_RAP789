
projection;
strict ( 2 );

use draft;
use side effects;

define behavior for ZC_PO_UPLOAD1
alias Upload

{
  use create;
  use update;
  use delete;


  use action UploadExcel;

  use action CreatePO;


  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;


  use association _Items
  {
    with draft;
  }

}



define behavior for ZC_PO_UPLOAD_ITEM1
alias Item

{
  use association _Upload
  {
    with draft;
  }
}